# ====================================================================
# .gitignore - VIAGEM / IAS Content Platform
# Proteção estrita contra vazamento de credenciais, chaves, bancos e arquivos pesados
# ====================================================================

# Credenciais e Segredos (NUNCA COMMITAR)
credentials/*.json
!credentials/gdrive_credentials.json.example
*.token.json
*secret*.json
*.env*
!.env.example
.env
.env.local

# Google Drive Tokens e Logs Locais
credentials/gdrive_token.json
auth_log.txt
*.log

# Bancos de Dados Locais e Arquivos Temporários SQLite
database/*.db
database/*.db-wal
database/*.db-shm
database/*.db-journal
database/*.sqlite
database/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Mídias e Arquivos Temporários de Vídeo/Áudio (Google Drive 5 TB é o repositório oficial)
workspace/downloads/
workspace/downloads/**
workspace/clips/*.mp4
workspace/clips/*.wav
workspace/clips/*.ass
workspace/clips/*.json
workspace/catalog_temp/*
workspace/subs/*
workspace/audio/*
!workspace/downloads/.gitkeep
!workspace/clips/.gitkeep
!workspace/subs/.gitkeep
!workspace/audio/.gitkeep

# Python e Ambientes
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Arquivos Temporários e Backups
*.bak
*.tmp
scratch/

# IDEs e Editores
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
