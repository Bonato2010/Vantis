# ==============================================================================
# VANTIS / CENTRAL SHORTS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copie este arquivo para '.env' e configure conforme o seu ambiente local.
# NUNCA comite chaves de API reais, credenciais ou segredos neste arquivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR E APLICAÇÃO
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=False
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-string

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS RELACIONAL (SQLite WAL)
# ------------------------------------------------------------------------------
DATABASE_PATH=database/shorts_central.db
SQLITE_WAL_MODE=True
SQLITE_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 3. POLÍTICA DE CUSTOS & GATEWAY DE MODELOS ($0.00 POLICY)
# Trava de software obrigatória: chamadas tarifadas pagas são bloqueadas por padrão.
# ------------------------------------------------------------------------------
ENFORCE_FREE_TIER_ONLY=True
MODEL_GATEWAY_TIMEOUT=5

# Provedores Gratuitos e Locais (Opcionais com quota gratuita):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. PROCESSAMENTO AUDIOVISUAL LOCAL (Open Source)
# ------------------------------------------------------------------------------
# Caminhos para binários (resolvidos automaticamente no PATH se omitidos)
# FFMPEG_BIN_PATH=C:\Program Files\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN_PATH=C:\Program Files\ffmpeg\bin\ffprobe.exe

# Faster-Whisper
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Edge-TTS (Vozes Neurais Gratuitas)
DEFAULT_TTS_VOICE=pt-BR-AntonioNeural
DEFAULT_TTS_RATE=+0%
DEFAULT_TTS_PITCH=+0Hz

# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE (Armazenamento Central de 5 TB)
# ------------------------------------------------------------------------------
GDRIVE_CREDENTIALS_PATH=credentials/gdrive_credentials.json
GDRIVE_TOKEN_PATH=credentials/gdrive_token.json
GDRIVE_CONFIG_FOLDERS=config/gdrive_folders.json
GDRIVE_AUTO_DELETE_LOCAL_AFTER_UPLOAD=True

# ------------------------------------------------------------------------------
# 6. YOUTUBE DATA API v3 (Publicação Protegida)
# Uploads são forçados estritamente com privacyStatus: 'private'.
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secrets.json
YOUTUBE_FORCE_PRIVATE_UPLOADS=True
YOUTUBE_MANDATORY_HUMAN_APPROVAL_GATE=True

# ------------------------------------------------------------------------------
# 7. FILA DE TAREFAS & CONCORRÊNCIA
# ------------------------------------------------------------------------------
MAX_CONCURRENT_TASKS_PER_CHANNEL=2
TASK_STALLED_TIMEOUT_SECONDS=600
TASK_MAX_RETRY_ATTEMPTS=3
